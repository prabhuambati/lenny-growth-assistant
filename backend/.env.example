# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_assistant

# --- Model provider toggle: ollama | anthropic | openai | gemini ---
MODEL_PROVIDER=ollama

# --- Local (mandatory for the demo) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Cloud (optional — leave blank to keep Ollama-only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval tuning (optional) ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
SHIP30_GENERATION_TIMEOUT_SECONDS=600
NORMAL_CHAT_GENERATION_TIMEOUT_SECONDS=300

# --- HTTP security ---
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Misc ---
LOG_LEVEL=INFO
